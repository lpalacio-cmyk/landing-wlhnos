# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno. Copiar a .env.local para desarrollo, o cargarlas en
# Vercel → Project → Settings → Environment Variables.
#
# NINGUNA es obligatoria: sin configurar nada, el sitio funciona y el formulario
# de contacto deriva la consulta a WhatsApp con el texto ya redactado.
# ─────────────────────────────────────────────────────────────────────────────

# Envío del formulario de contacto por correo (https://resend.com — plan gratuito
# suficiente para el volumen de una landing). Sin esta clave, el formulario abre
# WhatsApp con la consulta precargada en lugar de enviar un correo.
RESEND_API_KEY=

# Casilla que recibe las consultas. Por defecto: estudio@wlhnos.com
CONTACTO_EMAIL_DESTINO=

# Remitente. Para usar un dominio propio hay que verificarlo antes en Resend.
# Mientras tanto sirve el remitente de prueba: "Web WL Hnos. <onboarding@resend.dev>"
CONTACTO_EMAIL_REMITENTE=

# URL pública del sitio. Se usa para las URLs canónicas y las previsualizaciones
# al compartir en WhatsApp, LinkedIn, etc. Ej.: https://wlhnos.com
NEXT_PUBLIC_SITE_URL=
